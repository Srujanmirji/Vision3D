# Run with a shell-loaded environment from backend/.
VISION3D_DATA_DIR=./data
# Local TripoSR on this machine (recommended on Apple Silicon): run scripts/setup-local-triposr.sh, then
# point this at its folder. It becomes the first provider; hosted options below become fallbacks.
# LOCAL_TRIPOSR_HOME=~/vision3d-triposr
# Configure a free, operator-owned Space compatible with the TripoSR demo API.
# TRIPOSR_SPACE=organization/space
# HF_TOKEN=server-side-only-token
VISION3D_COMMUNITY_DEMO=0
# 1 enables a shape-only fallback subject to license and ZeroGPU quota.
VISION3D_SHAPE_FALLBACK=0
# PUBLIC_APP_URL=https://your-public-tunnel.example
BACKEND_API_BASE_URL=http://localhost:8000
LOCAL_FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_BYTES=10000000
MAX_MODEL_BYTES=10000000
JOB_TIMEOUT_SECONDS=300
PROVIDER_TIMEOUT_SECONDS=190
RETENTION_DAYS=7
SHARE_TTL_SECONDS=3600

QUEUE_TIMEOUT_SECONDS=1200
PRUNE_INTERVAL_SECONDS=3600
# Trust only an edge that overwrites X-Vision3D-Client-IP. Leave blank for local development.
TRUSTED_PROXY_IPS=
QUEUE_LIMIT=5
UPLOADS_PER_MINUTE=8
