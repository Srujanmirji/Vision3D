# Server-side Next.js rewrite destination for same-origin /api/* proxy
VISION3D_BACKEND_ORIGIN=http://127.0.0.1:8000

# Optional override for client API base URL (defaults to /api same-origin proxy)
NEXT_PUBLIC_API_BASE_URL=/api

# Public HTTPS origin for QR codes and mobile AR links (never encode localhost in production QR codes)
NEXT_PUBLIC_PUBLIC_APP_URL=
